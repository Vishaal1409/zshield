{
  "about": "10 edge-case requests for POST /score (Balaa, task 10). Each case is the base payment with 'patch' applied ('remove' deletes fields). 'expect_status' is the HTTP status; 'expect_decision' is checked when present. Run: python -m pytest api/tests/test_edge_cases.py -q",
  "base": {"txn_id": "E0", "step": 626, "type": "TRANSFER", "amount": 5000.0, "nameOrig": "C_EDGE_O",
           "oldbalanceOrg": 20000.0, "newbalanceOrig": 15000.0, "nameDest": "C_EDGE_D",
           "oldbalanceDest": 1000.0, "newbalanceDest": 6000.0},
  "cases": [
    {"name": "zero_amount", "patch": {"txn_id": "E1", "type": "PAYMENT", "amount": 0.0, "newbalanceOrig": 20000.0, "newbalanceDest": 1000.0}, "expect_status": 200, "expect_decision": "APPROVE"},
    {"name": "huge_amount_full_drain", "patch": {"txn_id": "E2", "amount": 9.9e12, "oldbalanceOrg": 9.9e12, "newbalanceOrig": 0.0, "oldbalanceDest": 0.0, "newbalanceDest": 0.0}, "expect_status": 200, "expect_decision": "HOLD"},
    {"name": "negative_amount", "patch": {"txn_id": "E3", "amount": -50.0}, "expect_status": 422},
    {"name": "missing_field", "patch": {"txn_id": "E4"}, "remove": ["nameDest"], "expect_status": 422},
    {"name": "repeated_txn_id", "patch": {"txn_id": "E5"}, "send_twice": true, "expect_status": 200},
    {"name": "amount_not_a_number", "patch": {"txn_id": "E6", "amount": "abc"}, "expect_status": 422},
    {"name": "amount_nan", "patch": {"txn_id": "E7", "amount": "NaN"}, "expect_status": 422},
    {"name": "empty_txn_id", "patch": {"txn_id": ""}, "expect_status": 422},
    {"name": "negative_step", "patch": {"txn_id": "E9", "step": -1}, "expect_status": 422},
    {"name": "unknown_type", "patch": {"txn_id": "E10", "type": "CRYPTO"}, "expect_status": 200}
  ]
}
